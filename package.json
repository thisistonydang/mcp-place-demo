{
  "name": "mcp-place-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "check": "prettier --check . && eslint . && vitest run && tsc --noEmit"
  },
  "dependencies": {
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@neon/functions": "^0.11.0",
    "@neon/realtime": "^0.1.2",
    "@neon/realtime-drizzle": "^0.1.0",
    "@neon/realtime-react": "^0.1.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "latest",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "latest",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
